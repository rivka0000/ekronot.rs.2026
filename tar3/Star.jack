class Star {

    field int x;
    field int y;
    field int size;
    field int rotation;

    constructor Star new(int startX, int startY) {
        let x = startX;
        let y = startY;
        let size = 30;
        let rotation = 0;
        return this;
    }

    method void draw() {
        var int h;
        var int q;

        // Calculates half and quarter of the star size
        let h = Math.divide(size, 2);
        let q = Math.divide(size, 4);

        do Screen.setColor(true);

        if (rotation = 0) {
            // Draws the star facing up
            do Screen.drawLine(x, y - size, x + q, y - h);
            do Screen.drawLine(x + q, y - h, x + size, y - h);
            do Screen.drawLine(x + size, y - h, x + h, y);
            do Screen.drawLine(x + h, y, x + h, y + size);
            do Screen.drawLine(x + h, y + size, x, y + h);
            do Screen.drawLine(x, y + h, x - h, y + size);
            do Screen.drawLine(x - h, y + size, x - h, y);
            do Screen.drawLine(x - h, y, x - size, y - h);
            do Screen.drawLine(x - size, y - h, x - q, y - h);
            do Screen.drawLine(x - q, y - h, x, y - size);
        }

        if (rotation = 90) {
            // Draws the star rotated to the right
            do Screen.drawLine(x + size, y, x + h, y + q);
            do Screen.drawLine(x + h, y + q, x + h, y + size);
            do Screen.drawLine(x + h, y + size, x, y + h);
            do Screen.drawLine(x, y + h, x - size, y + h);
            do Screen.drawLine(x - size, y + h, x - h, y);
            do Screen.drawLine(x - h, y, x - size, y - h);
            do Screen.drawLine(x - size, y - h, x, y - h);
            do Screen.drawLine(x, y - h, x + h, y - size);
            do Screen.drawLine(x + h, y - size, x + h, y - q);
            do Screen.drawLine(x + h, y - q, x + size, y);
        }

        if (rotation = 180) {
            // Draws the star upside down
            do Screen.drawLine(x, y + size, x - q, y + h);
            do Screen.drawLine(x - q, y + h, x - size, y + h);
            do Screen.drawLine(x - size, y + h, x - h, y);
            do Screen.drawLine(x - h, y, x - h, y - size);
            do Screen.drawLine(x - h, y - size, x, y - h);
            do Screen.drawLine(x, y - h, x + h, y - size);
            do Screen.drawLine(x + h, y - size, x + h, y);
            do Screen.drawLine(x + h, y, x + size, y + h);
            do Screen.drawLine(x + size, y + h, x + q, y + h);
            do Screen.drawLine(x + q, y + h, x, y + size);
        }

        if (rotation = 270) {
            // Draws the star rotated to the left
            do Screen.drawLine(x - size, y, x - h, y - q);
            do Screen.drawLine(x - h, y - q, x - h, y - size);
            do Screen.drawLine(x - h, y - size, x, y - h);
            do Screen.drawLine(x, y - h, x + size, y - h);
            do Screen.drawLine(x + size, y - h, x + h, y);
            do Screen.drawLine(x + h, y, x + size, y + h);
            do Screen.drawLine(x + size, y + h, x, y + h);
            do Screen.drawLine(x, y + h, x - h, y + size);
            do Screen.drawLine(x - h, y + size, x - h, y + q);
            do Screen.drawLine(x - h, y + q, x - size, y);
        }

        return;
    }

    method void erase() {
        var int offset;
        var int x1, y1, x2, y2;

        let offset = Math.multiply(size, 2);

        let x1 = Math.max(0, x - offset);
        let y1 = Math.max(0, y - offset);
        let x2 = Math.min(511, x + offset);
        let y2 = Math.min(255, y + offset);

        do Screen.setColor(false);
        // Erases the star area before moving or changing it
        do Screen.drawRectangle(x1, y1, x2, y2);
        return;
    }

    method void moveRight() {
        // Moves the star right if it stays inside the screen
        if ((x + size + 5) < 511) {
            do erase();
            let x = x + 10;
            do draw();
        }
        return;
    }

    method void moveLeft() {
        // Moves the star left if it stays inside the screen
        if ((x - size - 5) > 0) {
            do erase();
            let x = x - 10;
            do draw();
        }
        return;
    }

    method void moveUp() {
        // Moves the star up if it stays inside the screen
        if ((y - size - 5) > 0) {
            do erase();
            let y = y - 10;
            do draw();
        }
        return;
    }

    method void moveDown() {
        // Moves the star down if it stays inside the screen
        if ((y + size + 5) < 255) {
            do erase();
            let y = y + 10;
            do draw();
        }
        return;
    }

    method void grow() {
        // Makes the star bigger
        do erase();
        let size = Math.multiply(size, 2);

        if (size > 50) {
            let size = 50;
        }

        do draw();
        return;
    }

    method void shrink() {
        // Makes the star smaller
        if (size > 15) {
            do erase();
            let size = Math.divide(size, 2);
            do draw();
        }
        return;
    }

    method void rotate() {
        // Rotates the star by 90 degrees
        do erase();
        let rotation = rotation + 90;

        if (rotation = 360) {
            let rotation = 0;
        }

        do draw();
        return;
    }
}