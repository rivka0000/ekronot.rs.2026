class ShapeA {

    field int x, y;
    field int width, height;

    constructor ShapeA new(int startX, int startY) {
        let x = startX;
        let y = startY;

        let width = 40;
        let height = 20;

        return this;
    }

    method void draw() {
        do Screen.setColor(true);

        do Screen.drawRectangle(
            x,
            y,
            x + width,
            y + height
        );

        return;
    }

    method void erase() {
        do Screen.setColor(false);

        do Screen.drawRectangle(
            x,
            y,
            x + width,
            y + height
        );

        return;
    }

    method void moveRight() {
        do erase();
        let x = x + 10;
        do draw();
        return;
    }

    method void moveLeft() {
        do erase();
        let x = x - 10;
        do draw();
        return;
    }

    method void moveUp() {
        do erase();
        let y = y - 10;
        do draw();
        return;
    }

    method void moveDown() {
        do erase();
        let y = y + 10;
        do draw();
        return;
    }
}