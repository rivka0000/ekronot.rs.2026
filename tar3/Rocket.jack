class Rocket {

    field int x;
    field int y;

    field int size;
    field int rotation;

    constructor Rocket new(int startX, int startY) {
        let x = startX;
        let y = startY;
        let size = 25;
        let rotation = 0;
        return this;
    }

    method void draw() {
        var int halfSize;
        var int bodySize;
        var int flameSize;

        let halfSize = Math.divide(size, 2);
        let bodySize = Math.multiply(size, 2);
        let flameSize = Math.divide(size, 3);

        do Screen.setColor(true);

        if (rotation = 0) {
            // Draws the rocket nose pointing up
            do Screen.drawLine(x, y - size, x - halfSize, y);
            do Screen.drawLine(x, y - size, x + halfSize, y);
            // Draws the rocket body
            do Screen.drawRectangle(x - halfSize, y, x + halfSize, y + bodySize);
            // Draws the rocket wings
            do Screen.drawLine(x - halfSize, y + size, x - size, y + bodySize);
            do Screen.drawLine(x + halfSize, y + size, x + size, y + bodySize);
            // Draws the rocket flame
            do Screen.drawLine(x - flameSize, y + bodySize, x, y + bodySize + flameSize);
            do Screen.drawLine(x + flameSize, y + bodySize, x, y + bodySize + flameSize);
        }

        if (rotation = 90) {
            // Draws the rocket nose pointing right
            do Screen.drawLine(x + size, y, x, y - halfSize);
            do Screen.drawLine(x + size, y, x, y + halfSize);
            // Draws the rocket body
            do Screen.drawRectangle(x - bodySize, y - halfSize, x, y + halfSize);
            // Draws the rocket wings
            do Screen.drawLine(x - size, y - halfSize, x - bodySize, y - size);
            do Screen.drawLine(x - size, y + halfSize, x - bodySize, y + size);
            // Draws the rocket flame
            do Screen.drawLine(x - bodySize, y - flameSize, x - bodySize - flameSize, y);
            do Screen.drawLine(x - bodySize, y + flameSize, x - bodySize - flameSize, y);
        }

        if (rotation = 180) {
            // Draws the rocket nose pointing down
            do Screen.drawLine(x, y + size, x - halfSize, y);
            do Screen.drawLine(x, y + size, x + halfSize, y);
            // Draws the rocket body
            do Screen.drawRectangle(x - halfSize, y - bodySize, x + halfSize, y);
            // Draws the rocket wings
            do Screen.drawLine(x - halfSize, y - size, x - size, y - bodySize);
            do Screen.drawLine(x + halfSize, y - size, x + size, y - bodySize);
            // Draws the rocket flame
            do Screen.drawLine(x - flameSize, y - bodySize, x, y - bodySize - flameSize);
            do Screen.drawLine(x + flameSize, y - bodySize, x, y - bodySize - flameSize);
        }

        if (rotation = 270) {
            // Draws the rocket nose pointing left
            do Screen.drawLine(x - size, y, x, y - halfSize);
            do Screen.drawLine(x - size, y, x, y + halfSize);
            // Draws the rocket body
            do Screen.drawRectangle(x, y - halfSize, x + bodySize, y + halfSize);
            // Draws the rocket wings
            do Screen.drawLine(x + size, y - halfSize, x + bodySize, y - size);
            do Screen.drawLine(x + size, y + halfSize, x + bodySize, y + size);
            // Draws the rocket flame
            do Screen.drawLine(x + bodySize, y - flameSize, x + bodySize + flameSize, y);
            do Screen.drawLine(x + bodySize, y + flameSize, x + bodySize + flameSize, y);
        }

        return;
    }

    method void erase() {
        var int offset;
        var int x1, y1, x2, y2;

        let offset = Math.multiply(size, 3);

        let x1 = Math.max(0, x - offset);
        let y1 = Math.max(0, y - offset);
        let x2 = Math.min(511, x + offset);
        let y2 = Math.min(255, y + offset);

        do Screen.setColor(false);
        // Erases the rocket area before moving or changing it
        do Screen.drawRectangle(x1, y1, x2, y2);

        return;
    }

    method void moveRight() {
        // Moves the rocket right if it stays inside the screen
        if ((x + Math.multiply(size, 2) + 15) < 511) {
            do erase();
            let x = x + 10;
            do draw();
        }
        return;
    }

    method void moveLeft() {
        // Moves the rocket left if it stays inside the screen
        if ((x - Math.multiply(size, 2) - 15) > 0) {
            do erase();
            let x = x - 10;
            do draw();
        }
        return;
    }

    method void moveUp() {
        // Moves the rocket up if it stays inside the screen
        if ((y - Math.multiply(size, 2) - 15) > 0) {
            do erase();
            let y = y - 10;
            do draw();
        }
        return;
    }

    method void moveDown() {
        // Moves the rocket down if it stays inside the screen
        if ((y + Math.multiply(size, 2) + 15) < 255) {
            do erase();
            let y = y + 10;
            do draw();
        }
        return;
    }

    method void grow() {
        // Makes the rocket bigger
        do erase();
        let size = Math.multiply(size, 2);

        if (size > 40) {
            let size = 40;
        }

        do draw();
        return;
    }

    method void shrink() {
        // Makes the rocket smaller
        if (size > 15) {
            do erase();
            let size = Math.divide(size, 2);
            do draw();
        }
        return;
    }

    method void rotate() {
        // Rotates the rocket by 90 degrees
        do erase();
        let rotation = rotation + 90;

        if (rotation = 360) {
            let rotation = 0;
        }

        do draw();
        return;
    }
}